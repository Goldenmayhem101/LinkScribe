<resources>
    <color name="bg">#101030</color>

    <!-- Launch screen: the Tiltrix icon on the game night background (Android's splash screen) -->
    <style name="Theme.Game.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#101030</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenIconBackgroundColor">#101030</item>
        <item name="postSplashScreenTheme">@style/Theme.Game</item>
    </style>

    <style name="Theme.Game" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>
</resources>
